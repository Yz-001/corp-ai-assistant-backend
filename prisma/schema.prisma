generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ 租户 ============
model Tenant {
  id         String   @id @default(cuid())
  name       String
  code       String   @unique
  type       String   @default("enterprise") // public | sales | partner | enterprise
  status     String   @default("enabled")     // enabled | disabled
  planType   String   @default("basic")       // basic | pro | enterprise
  quotaJson  String   @default("{}")          // JSON: quota config
  configJson String   @default("{}")          // JSON: tenant config
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users              User[]
  chatSessions       ChatSession[]
  documents          Document[]
  promptConfigs      PromptConfig[]
  usageRecords       UsageRecord[]
  tenantToolPerms    TenantToolPermission[]
  qaLogs             QaLog[]
  toolCallLogs       ToolCallLog[]
  auditLogs          AuditLog[]
}

// ============ 用户 ============
model User {
  id           String    @id @default(cuid())
  tenantId     String
  username     String    @unique
  email        String?
  passwordHash String
  role         String    @default("tenant_user") // super_admin | tenant_admin | tenant_user | public_user
  status       String    @default("enabled")     // enabled | disabled
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// ============ 会话 ============
model ChatSession {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String
  title         String    @default("新会话")
  channel       String    @default("web") // web | public_widget | wecom
  status        String    @default("active") // active | archived | deleted
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  messages      ChatMessage[]

  @@index([tenantId, userId])
  @@index([tenantId, status])
}

// ============ 消息 ============
model ChatMessage {
  id           String   @id @default(cuid())
  tenantId     String
  sessionId    String
  role         String   // user | assistant | system | tool
  content      String
  status       String   @default("pending") // pending | generating | done | failed | stopped
  sourcesJson  String   @default("[]")      // JSON: sources array
  toolCallsJson String  @default("[]")      // JSON: tool calls array
  tokenUsageJson String @default("{}")      // JSON: token usage
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  session      ChatSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([tenantId])
}

// ============ 提示词配置 ============
model PromptConfig {
  id        String   @id @default(cuid())
  tenantId  String
  scope     String   @default("global") // global | tenant | channel
  channel   String   @default("web")    // web | public_widget | wecom
  type      String   // tag | suggested_question
  title     String
  content   String
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, type, enabled])
}

// ============ 文档 ============
model Document {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  fileName     String
  fileType     String   // pdf | docx | txt | md
  fileSize     Int      @default(0)
  storagePath  String   @default("")
  visibility   String   @default("private") // public | private
  status       String   @default("pending") // pending | processing | completed | failed
  chunkCount   Int      @default(0)
  createdBy    String?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  chunks       DocumentChunk[]

  @@index([tenantId, status])
  @@index([tenantId, visibility])
}

// ============ 文档切块 ============
model DocumentChunk {
  id          String   @id @default(cuid())
  tenantId    String
  documentId  String
  chunkIndex  Int
  content     String
  tokenCount  Int      @default(0)
  metadataJson String @default("{}") // JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  document    Document @relation(fields: [documentId], references: [id])

  @@index([documentId])
  @@index([tenantId])
}

// ============ 问答日志 ============
model QaLog {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String?
  sessionId        String?
  query            String
  answer           String?
  modelName        String?
  latencyMs        Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  sourceCount      Int      @default(0)
  status           String   @default("success") // success | failed
  errorMessage     String?
  createdAt        DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

// ============ 工具定义 ============
model ToolDefinition {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  type         String   // internal_api | database_query | http_service | mcp_tool
  description  String   @default("")
  status       String   @default("enabled") // enabled | disabled
  configJson   String   @default("{}")
  healthStatus String   @default("unknown") // healthy | unhealthy | unknown
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantToolPerms TenantToolPermission[]
  toolCallLogs    ToolCallLog[]
}

// ============ 租户工具权限 ============
model TenantToolPermission {
  id        String   @id @default(cuid())
  tenantId  String
  toolId    String
  enabled   Boolean  @default(false)
  configJson String @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  tool      ToolDefinition  @relation(fields: [toolId], references: [id])

  @@unique([tenantId, toolId])
}

// ============ 工具调用日志 ============
model ToolCallLog {
  id            String   @id @default(cuid())
  tenantId      String
  sessionId     String?
  messageId     String?
  toolId        String?
  toolName      String
  requestJson   String   @default("{}")
  responseJson  String   @default("{}")
  latencyMs     Int      @default(0)
  status        String   @default("success") // success | failed
  errorMessage  String?
  createdAt     DateTime @default(now())

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  tool          ToolDefinition? @relation(fields: [toolId], references: [id])

  @@index([tenantId, createdAt])
  @@index([toolId])
}

// ============ MCP 服务 ============
model McpServer {
  id               String   @id @default(cuid())
  name             String
  baseUrl          String
  authType         String   @default("none") // none | bearer | basic | api_key
  authConfigJson   String   @default("{}")
  status           String   @default("enabled") // enabled | disabled
  timeoutSeconds   Int      @default(20)
  description      String   @default("")
  lastCheckAt      DateTime?
  lastCheckStatus  String   @default("unknown") // success | failed | unknown
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mcpTools         McpTool[]
}

// ============ MCP 工具 ============
model McpTool {
  id          String    @id @default(cuid())
  serverId    String
  toolCode    String
  toolName    String
  description String    @default("")
  schemaJson  String    @default("{}")
  status      String    @default("enabled") // enabled | disabled
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  server      McpServer @relation(fields: [serverId], references: [id])

  @@unique([serverId, toolCode])
}

// ============ 使用量记录 ============
model UsageRecord {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String?
  serviceType  String   // chat | tool | document
  requestCount Int      @default(0)
  tokenCount   Int      @default(0)
  cost         Float    @default(0)
  statDate     String   // YYYY-MM-DD
  createdAt    DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, userId, serviceType, statDate])
  @@index([tenantId, statDate])
}

// ============ 审计日志 ============
model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  operatorId  String?
  module      String   // auth | tenant | document | tool | mcp | system
  action      String   // create | update | delete | login | logout
  targetType  String?
  targetId    String?
  detailJson  String   @default("{}")
  createdAt   DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([module, action])
}
